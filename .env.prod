DJANGO_SECRET_KEY=replace_this_with_a_very_long_and_secure_random_string_here_for_production
ALLOWED_HOSTS=api.arkkala.com,arkkala.com,localhost,127.0.0.1,arkkala_prod_django
CORS_ALLOWED_ORIGINS=https://arkkala.com,https://www.arkkala.com
