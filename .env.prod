# Django Core
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_50_RANDOM_CHARS
DJANGO_SETTINGS_MODULE=arkkala.settings.prod

# Domains & Security
ALLOWED_HOSTS=backend.vandavision.ir,front.vandavision.ir
CORS_ALLOWED_ORIGINS=https://front.vandavision.ir,https://backend.vandavision.ir
CSRF_TRUSTED_ORIGINS=https://front.vandavision.ir,https://backend.vandavision.ir
FRONTEND_URL=https://front.vandavision.ir
SITE_NAME=ارک کالا

POSTGRES_DB=arkkala_prod_db
POSTGRES_USER=arkkala_prod_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/1
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# Auth & SMS (Kavenegar)
AUTH_MODE=otp
KAVENEGAR_API_KEY=CHANGE_ME_KAVENEGAR_API_KEY
KAVENEGAR_OTP_TEMPLATE=verify

PGADMIN_DEFAULT_EMAIL=admin@vandavision.ir
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PGADMIN_PASSWORD